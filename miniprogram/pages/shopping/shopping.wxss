/* pages/shopping/shopping.wxss */
.page {
  min-height: 100vh;
  padding: 16rpx 0 40rpx;
}

/* 添加栏 */
.addbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
}
.addbar__name {
  flex: 3;
  background: var(--color-bg);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
}
.addbar__qty,
.addbar__unit {
  flex: 1;
  background: var(--color-bg);
  border-radius: 8rpx;
  padding: 12rpx 12rpx;
  font-size: 28rpx;
  text-align: center;
}
.addbar__btn {
  flex: none;
  background: var(--color-primary);
  color: var(--color-white);
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 分区 */
.section {
  margin-top: 8rpx;
}
.section__title {
  padding: 20rpx 32rpx 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* 购物项 */
.sitem {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sitem__info {
  flex: 1;
  min-width: 0;
}
.sitem__name {
  font-size: 30rpx;
  font-weight: 500;
}
.sitem__qty {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: normal;
  margin-left: 8rpx;
}
.sitem__source {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.sitem__actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.buy-btn {
  margin: 0;
  background: var(--color-green);
  color: var(--color-white);
  border-radius: 32rpx;
  font-size: 26rpx;
}
.link--danger {
  color: var(--color-red);
  font-size: 26rpx;
}
