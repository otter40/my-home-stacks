<!-- pages/ingredients/edit/edit.wxml — 新增/编辑食材 -->
<view class="page">
  <view class="field">
    <text class="field__label">名称</text>
    <input class="field__input" placeholder="必填，如 番茄" value="{{name}}" bindinput="onNameInput" />
  </view>

  <view class="field">
    <text class="field__label">食材分类</text>
    <view class="field__row">
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value">{{categories[categoryIndex] || '请选择'}} ▾</view>
      </picker>
      <text class="tlink" bindtap="onAddCategory">＋ 新增分类</text>
    </view>
  </view>

  <view class="field">
    <text class="field__label">默认单位（可选）</text>
    <input class="field__input" placeholder="个 / g / 把…" value="{{defaultUnit}}" bindinput="onUnitInput" />
  </view>

  <button class="save-btn" bindtap="onSave">保存</button>
</view>
