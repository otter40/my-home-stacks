<!-- pages/profile/profile.wxml — 我的 -->
<view class="page">
  <!-- 使用统计 -->
  <view class="section-title">使用统计</view>
  <view class="card stats">
    <view class="stats__row">
      <view class="stats__cell">
        <view class="stats__num">{{total}}</view>
        <view class="stats__label">累计做菜</view>
      </view>
      <view class="stats__cell">
        <view class="stats__num">{{weekly}}</view>
        <view class="stats__label">近 7 天</view>
      </view>
    </view>
    <view wx:if="{{topList.length > 0}}" class="stats__top">
      <view class="stats__top-title">高频菜</view>
      <view wx:for="{{topList}}" wx:key="name" class="stats__top-row">
        <text>{{index + 1}}. {{item.name}}</text>
        <text class="muted">{{item.count}} 次</text>
      </view>
    </view>
    <view wx:else class="muted">还没有做菜记录，去首页「做完了」试试吧</view>
  </view>

  <!-- 管理 -->
  <view class="section-title">管理</view>
  <view class="card list">
    <view class="row" bindtap="goOptions">
      <text>分类 / 标签管理</text><text class="row__arrow">›</text>
    </view>
    <view class="row" bindtap="onExport">
      <text>导出数据到剪贴板</text><text class="row__arrow">›</text>
    </view>
    <view class="row" bindtap="onImport">
      <text>从剪贴板导入数据</text><text class="row__arrow">›</text>
    </view>
  </view>

  <!-- 危险操作 -->
  <view class="section-title">数据</view>
  <view class="card list">
    <view class="row" bindtap="onReset">
      <text>恢复示例数据</text><text class="row__arrow">›</text>
    </view>
    <view class="row row--danger" bindtap="onClear">
      <text>清空全部数据</text><text class="row__arrow">›</text>
    </view>
  </view>

  <view class="footer">王家今天吃什么 · 本地存储 · 无需联网</view>
</view>
