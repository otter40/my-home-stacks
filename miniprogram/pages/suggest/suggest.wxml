<!-- pages/suggest/suggest.wxml — 冰箱能做什么 -->
<view class="page">
  <block wx:if="{{hasAny}}">
    <view wx:if="{{canMake.length > 0}}" class="section-title">可以做（{{canMake.length}}）</view>
    <view wx:for="{{canMake}}" wx:key="id" class="card dish">
      <view class="dish__head">
        <text class="dish__name">{{item.name}}</text>
        <view class="dish__tags">
          <text wx:for="{{item.types}}" wx:for-item="t" wx:key="*this" class="chip">{{t}}</text>
        </view>
      </view>
      <view class="dish__main">主料齐全：{{item.mainText}}</view>
      <view class="dish__foot">
        <button wx:if="{{item.isToday}}" class="mini-btn" size="mini" disabled>已加入</button>
        <button wx:else class="mini-btn mini-btn--accent" size="mini" data-id="{{item.id}}" bindtap="onAddToday">加入想吃</button>
      </view>
    </view>

    <view wx:if="{{almost.length > 0}}" class="section-title">差一点点（{{almost.length}}）</view>
    <view wx:for="{{almost}}" wx:key="id" class="card dish">
      <view class="dish__head">
        <text class="dish__name">{{item.name}}</text>
        <view class="dish__tags">
          <text wx:for="{{item.types}}" wx:for-item="t" wx:key="*this" class="chip">{{t}}</text>
        </view>
      </view>
      <view class="dish__missing">还差主料：{{item.missingText}}</view>
    </view>
  </block>

  <view wx:else class="empty">
    <view class="empty__emoji">❄️</view>
    <view class="empty__hint">现有库存还做不了完整的菜，去补点食材或添加新菜谱吧</view>
  </view>
</view>
