/* pages/today/today.wxss */
.page {
  min-height: 100vh;
  padding: 16rpx 0 40rpx;
}

.today__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.today__name {
  font-size: 34rpx;
  font-weight: 600;
}
.tag {
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.today__ings {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}
.today__foot {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
}
.done-btn {
  margin: 0;
  background: var(--color-green);
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
}

/* 空状态按钮组 */
.empty__actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
}
.entry-btn {
  background: var(--color-primary);
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
}
.entry-btn--ghost {
  background: #fff;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
}
