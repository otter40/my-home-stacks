/* pages/recipes/edit/edit.wxss */
.page {
  min-height: 100vh;
  padding: 16rpx 0 60rpx;
}

.field {
  background: var(--color-card);
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}
.field__label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}
.field__input,
.field__textarea {
  width: 100%;
  font-size: 30rpx;
}
.field__textarea {
  min-height: 120rpx;
  line-height: 1.6;
}
.field__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-value {
  font-size: 30rpx;
  color: var(--color-text);
}
.link {
  color: var(--color-primary);
  font-size: 26rpx;
}

/* 食材行 */
.ing-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.ing-row__name {
  flex: 3;
  background: var(--color-bg);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
}
.ing-row__qty,
.ing-row__unit {
  flex: 1;
  background: var(--color-bg);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  text-align: center;
}
.ing-row__del {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 32rpx;
}
.add-ing {
  margin-top: 8rpx;
  color: var(--color-primary);
  font-size: 28rpx;
}

.save-btn {
  margin: 40rpx 24rpx 0;
  background: var(--color-primary);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
}
