<!-- pages/recipes/edit/edit.wxml — 新增/编辑菜谱 -->
<view class="page">
  <!-- 菜名 -->
  <view class="field">
    <text class="field__label">菜名</text>
    <input
      class="field__input"
      placeholder="必填，如 番茄炒蛋"
      value="{{name}}"
      bindinput="onNameInput"
    />
  </view>

  <!-- 分类 -->
  <view class="field">
    <text class="field__label">分类</text>
    <view class="field__row">
      <picker
        class="field__picker"
        mode="selector"
        range="{{categories}}"
        value="{{categoryIndex}}"
        bindchange="onCategoryChange"
      >
        <view class="picker-value">{{categories[categoryIndex] || '请选择'}} ▾</view>
      </picker>
      <text class="link" bindtap="onAddCategory">＋ 新增分类</text>
    </view>
  </view>

  <!-- 食材列表 -->
  <view class="field">
    <text class="field__label">食材</text>
    <view wx:for="{{ingredients}}" wx:key="index" class="ing-row">
      <input
        class="ing-row__name"
        placeholder="名称"
        value="{{item.name}}"
        data-index="{{index}}"
        bindinput="onIngNameInput"
      />
      <input
        class="ing-row__qty"
        type="digit"
        placeholder="数量"
        value="{{item.qty}}"
        data-index="{{index}}"
        bindinput="onIngQtyInput"
      />
      <input
        class="ing-row__unit"
        placeholder="单位"
        value="{{item.unit}}"
        data-index="{{index}}"
        bindinput="onIngUnitInput"
      />
      <view class="ing-row__del" data-index="{{index}}" bindtap="onRemoveIng">✕</view>
    </view>
    <view class="add-ing" bindtap="onAddIng">＋ 添加一行食材</view>
  </view>

  <!-- 做法 -->
  <view class="field">
    <text class="field__label">做法（可选）</text>
    <textarea
      class="field__textarea"
      placeholder="写下做法步骤…"
      value="{{steps}}"
      bindinput="onStepsInput"
      auto-height
    />
  </view>

  <button class="save-btn" bindtap="onSave">保存</button>
</view>
