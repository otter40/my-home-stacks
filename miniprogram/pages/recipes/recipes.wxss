/* pages/recipes/recipes.wxss */
.page { min-height: 100vh; padding-bottom: 160rpx; }

/* 搜索栏 */
.searchbar {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  margin: 16rpx 24rpx 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}
.searchbar__icon { font-size: 28rpx; margin-right: 12rpx; }
.searchbar__input { flex: 1; font-size: 28rpx; }

/* 筛选行 */
.filter { white-space: nowrap; margin: 4rpx 0; }
.filter__inner { display: inline-flex; padding: 8rpx 24rpx; gap: 12rpx; }
.filter__chip {
  flex: none;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  border: 1rpx solid var(--color-border);
}
.filter__chip--on {
  background: var(--color-text);
  color: var(--color-white);
  border-color: var(--color-text);
}

/* 卡片 */
.recipe__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.recipe__name { font-size: 32rpx; font-weight: 600; flex: none; margin-right: 16rpx; }
.recipe__tags { flex: 1; text-align: right; }
.recipe__meta { margin-top: 10rpx; font-size: 24rpx; color: var(--color-text-secondary); }
.recipe__main { margin-top: 8rpx; font-size: 26rpx; color: var(--color-text-secondary); }
.recipe__foot {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.today-toggle {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  background: var(--color-bg);
}
.today-toggle--on {
  background: rgba(77, 171, 109, 0.14);
  color: #2F7D4C;
  border-color: rgba(77, 171, 109, 0.4);
}
.recipe__actions { display: flex; gap: 28rpx; }
