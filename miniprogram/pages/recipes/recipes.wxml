<!-- pages/recipes/recipes.wxml — 菜谱库 -->
<view class="page">
  <!-- 搜索栏 -->
  <view class="searchbar">
    <text class="searchbar__icon">🔍</text>
    <input
      class="searchbar__input"
      placeholder="搜索菜名"
      value="{{keyword}}"
      bindinput="onSearchInput"
      confirm-type="search"
    />
  </view>

  <!-- 分类筛选 Tab -->
  <scroll-view class="cats" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="cats__inner">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="cats__item {{activeCategory === item ? 'cats__item--active' : ''}}"
        data-cat="{{item}}"
        bindtap="onSelectCategory"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- 菜谱列表 -->
  <view wx:if="{{list.length > 0}}" class="list">
    <view wx:for="{{list}}" wx:key="id" class="card recipe">
      <view class="recipe__head">
        <text class="recipe__name">{{item.name}}</text>
        <text class="tag" style="background:{{item.tagColor}}">{{item.category}}</text>
      </view>
      <view class="recipe__ings">{{item.ingredientText}}</view>
      <view wx:if="{{item.isToday}}" class="recipe__today">已在今天吃 🍽️</view>
      <view class="recipe__actions">
        <button class="btn btn--ghost" size="mini" data-id="{{item.id}}" bindtap="onEdit">编辑</button>
        <button class="btn btn--danger" size="mini" data-id="{{item.id}}" bindtap="onDelete">删除</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty">
    <view class="empty__emoji">📖</view>
    <view class="empty__hint">
      {{keyword || activeCategory !== '全部' ? '没有符合条件的菜谱' : '还没有菜谱，点右下角 + 添加吧'}}
    </view>
  </view>

  <!-- 悬浮新增按钮 -->
  <view class="fab" bindtap="onAdd">＋</view>
</view>
