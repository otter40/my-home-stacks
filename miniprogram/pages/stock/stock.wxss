/* pages/stock/stock.wxss */
.page {
  min-height: 100vh;
  padding: 8rpx 0 160rpx;
}

/* 分组 */
.group__head {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 8rpx;
}
.group__title { font-size: 28rpx; font-weight: 600; }
.group__count { margin-left: 12rpx; font-size: 24rpx; color: var(--color-text-secondary); }
.group__arrow { margin-left: auto; color: var(--color-text-secondary); font-size: 28rpx; }

/* 食材卡 */
.inv__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.inv__title { display: flex; align-items: center; gap: 12rpx; }
.inv__name { font-size: 30rpx; font-weight: 500; }
.inv__qty { display: flex; align-items: center; }
.step {
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 6rpx;
  font-size: 34rpx;
  background: var(--color-bg-soft);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}
.step--plus { background: var(--color-accent); color: var(--color-white); border-color: var(--color-accent); }
.step__num { min-width: 56rpx; text-align: center; font-size: 30rpx; }
.inv__unit { margin-left: 8rpx; color: var(--color-text-secondary); font-size: 24rpx; }

.inv__statuses { margin-top: 12rpx; }

.inv__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}
/* 按钮式需要购买 */
.needbuy {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  background: var(--color-bg);
}
.needbuy--on {
  background: rgba(35, 131, 226, 0.12);
  color: var(--color-accent);
  border-color: rgba(35, 131, 226, 0.4);
}
.inv__actions { display: flex; gap: 28rpx; }
