/* pages/stock/edit/edit.wxss */
.page { min-height: 100vh; padding: 16rpx 0 60rpx; }

.field {
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-card);
}
.field__label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}
.field__input { width: 100%; font-size: 30rpx; }
.field--row2 { display: flex; gap: 24rpx; }
.field--row2 .col { flex: 1; }
.field__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-value { font-size: 30rpx; color: var(--color-text); }

.status-wrap { display: flex; flex-wrap: wrap; }
.status-chip {
  border: 1rpx solid var(--color-border);
  background: var(--color-bg);
  color: var(--color-text-secondary);
  padding: 8rpx 20rpx;
  margin: 6rpx 12rpx 6rpx 0;
}
.status-chip--on {
  background: rgba(35, 131, 226, 0.12);
  color: var(--color-accent);
  border-color: rgba(35, 131, 226, 0.4);
}

.save-btn {
  margin: 40rpx 24rpx 0;
  background: var(--color-accent);
  color: var(--color-white);
  border-radius: var(--radius-card);
  font-size: 32rpx;
}
