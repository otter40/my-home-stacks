/* pages/fridge/fridge.wxss */
.page {
  min-height: 100vh;
  padding: 16rpx 0 40rpx;
}

.section {
  margin-top: 16rpx;
}
.section__title {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.dot--green {
  background: var(--color-green);
}
.dot--yellow {
  background: var(--color-yellow);
}

.recipe__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.recipe__name {
  font-size: 32rpx;
  font-weight: 600;
}
.tag {
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.recipe__ings {
  margin-top: 12rpx;
  color: var(--color-green);
  font-size: 26rpx;
  line-height: 1.5;
}
.recipe__missing {
  margin-top: 12rpx;
  color: #C98A00;
  font-size: 26rpx;
  line-height: 1.5;
}
.recipe__foot {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}
.add-btn {
  margin: 0;
  background: var(--color-primary);
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
}
.add-btn--done {
  background: var(--color-bg);
  color: var(--color-text-secondary);
}
